# OriginLens environment variables.
# No secret is required for the P0 deterministic build.

# P1-001 (optional model explanation; disabled unless fully configured)
# No endpoint or model is assumed. If you enable this, set both explicitly and
# verify the provider's terms, data handling, and your authorization first.
# MODEL_EXPLANATION_ENABLED=false
# MODEL_API_KEY=
# MODEL_API_BASE_URL=https://your-provider.example/v1
# MODEL_NAME=your-model-id

