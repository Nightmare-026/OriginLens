# OriginLens environment variables.
# No secret is required for the P0 deterministic build.

# P1-001 (optional model explanation; disabled unless fully configured)
# Example configuration for Baseten Partner inference with Meta Muse Spark Open:
# MODEL_EXPLANATION_ENABLED=true
# MODEL_API_KEY=your_baseten_api_key
# MODEL_API_BASE_URL=https://inference.baseten.co/v1
# MODEL_NAME=meta-models/muse-spark-open-1026
#
# Muse Spark Open always reasons and draws reasoning + answer from max_tokens.
# These defaults are bounded in src/lib/model-provider/config.ts.
# MODEL_REASONING_EFFORT=low
# MODEL_MAX_TOKENS=3000
# MODEL_TIMEOUT_MS=45000
